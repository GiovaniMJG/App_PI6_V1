rules_version = '2';

// Regras abertas para fase de desenvolvimento/mock. Antes de ir para
// produção, restringir por autenticação (ex.: allow read, write: if
// request.auth != null).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
